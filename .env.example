# ==============================================================
# BloomCraft Studio - Environment Configuration
# ==============================================================

# 1. MongoDB Atlas Database Hosting
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bloomcraft_studio?retryWrites=true&w=majority

# 2. Cloudinary Real Cloud Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# 3. Authentication & Security
JWT_SECRET=bloomcraft-super-secret-jwt-key-change-in-production-2026

# 4. Payment Gateway Integration (Razorpay - Only after merchant onboarding)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# 5. Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

